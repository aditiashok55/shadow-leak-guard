# Copy this file to `.streamlit/secrets.toml` and fill in your key.
# `.streamlit/secrets.toml` is gitignored — NEVER commit real keys.
#
# On Streamlit Community Cloud you don't create this file: paste the same
# key = value lines into the app's Settings → Secrets box instead.

# --- Cloud deploy: use a hosted LLM instead of local Ollama ------------------
LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your_new_rotated_key_here"
GROQ_MODEL = "openai/gpt-oss-20b"

# --- Embeddings: run locally on CPU (no API, free) --------------------------
EMBED_PROVIDER = "sentence-transformers"

# --- Layer 2 graph backend: in-memory (no Neo4j server in the cloud) --------
GRAPH_BACKEND = "networkx"
