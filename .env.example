# Phase 2 (U1) — Langfuse tracing.
# Copy to .env and fill in. If these are absent, the pipeline runs unchanged
# and Langfuse spans become no-ops (JSON traces still work).

LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# Langfuse Cloud, or your self-hosted URL (e.g. http://localhost:3000)
LANGFUSE_HOST=https://cloud.langfuse.com
